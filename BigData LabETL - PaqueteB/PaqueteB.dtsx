                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT o.ObservacionId,
       CAST(p.DocumentType   AS NVARCHAR(10)) AS DocumentType,
       CAST(p.DocumentNumber AS NVARCHAR(50)) AS DocumentNumber,
       CAST(o.SurveyDate AS DATE)             AS Fecha,
       CAST(ISNULL(RTRIM(o.MunicipalityCode), 'M999') AS NVARCHAR(10)) AS MunicipalityCode,
       CAST(o.NivelEducativoId AS TINYINT)    AS NivelEducativoId,
       CAST(o.EstadoLaboralId  AS TINYINT)    AS EstadoLaboralId,
       o.MonthlyIncome, o.MonthlyExpenses, o.BalanceMensual
FROM dbo.OBSERVACION o
JOIN dbo.PERSONA p ON p.PersonaId = o.PersonaId;</property>
