                  expressionType="Notify"
                  name="SqlCommandParam"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select * from (SELECT PersonaKey, DocumentType, DocumentNumber FROM dbo.DIM_PERSONA) [refTable]
where [refTable].[DocumentType] = ? and [refTable].[DocumentNumber] = ?</property>
